{
  "manifest_version": 3,
  "name": "WhatsApp Web Customizer – Themes, Fonts, Backgrounds & Privacy",
  "version": "1.2.0",
  "description": "Customize WhatsApp Web: themes, fonts, backgrounds, font size, and privacy blur — blur names, previews & photos. Open source.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting",
    "clipboardRead",
    "alarms"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "WhatsApp Web Customizer"
  },
  "background": {
    "service_worker": "src/background/background.js"
  },
  "options_ui": {
    "page": "src/pages/options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "assets/icon/icon16.png",
    "48": "assets/icon/icon48.png",
    "128": "assets/icon/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/"
      ],
      "js": [
        "src/shared/track.js",
        "src/content/core/changeContent.js",
        "src/shared/themes-presets.js",
        "src/content/themes/themes-content.js",
        "src/shared/fonts-presets.js",
        "src/content/fonts/fonts-content.js",
        "src/content/core/reviewPrompt.js",
        "src/content/backgrounds/water-bubbles.js",
        "src/content/backgrounds/gradient-mesh.js",
        "src/content/backgrounds/liquid-marble.js",
        "src/content/backgrounds/cozy-window.js",
        "src/content/backgrounds/animated-bg.js",
        "src/content/features/adjustableChatList.js",
        "src/content/features/chatHoverPreview.js",
        "src/content/features/privacy-blur.js",
        "src/content/core/dynamic-features.js",
        "src/content/core/content.js",
        "src/content/slots/slots-fix.js",
        "src/content/core/first-run-hint.js"
      ],
      "css": [
        "src/content/features/adjustableChatList.css",
        "src/content/features/chatHoverPreview.css",
        "src/content/slots/slots-fix.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://web.whatsapp.com/",
    "https://eu.i.posthog.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/themes/themes-overrides.css",
        "assets/icon/icon128.png",
        "assets/backgrounds/animated/*/index.html",
        "assets/backgrounds/animated/*/thumbnail.png",
        "assets/backgrounds/animated/*/thumbnail.gif",
        "assets/backgrounds/animated/*/thumbnail.svg"
      ],
      "matches": [
        "https://web.whatsapp.com/*"
      ]
    }
  ]
}
